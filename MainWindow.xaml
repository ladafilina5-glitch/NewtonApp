<Window x:Class="NewtonApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Интеграл методом трапеций (параллельно)" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="ВЫЧИСЛЕНИЕ ИНТЕГРАЛА МЕТОДОМ ТРАПЕЦИЙ (Task + PostgreSQL)"
                   FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap"/>

        <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="2"
                CornerRadius="10" Margin="5" Padding="10">
            <StackPanel>
                <TextBlock Text="f(x) = x²" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="Нижний предел a:"/>
                <TextBox Text="{Binding A, UpdateSourceTrigger=PropertyChanged}"
                         Height="30" Margin="0,5,0,10" FontSize="14"/>

                <TextBlock Text="Верхний предел b:"/>
                <TextBox Text="{Binding B, UpdateSourceTrigger=PropertyChanged}"
                         Height="30" Margin="0,5,0,10" FontSize="14"/>

                <TextBlock Text="Количество отрезков N:"/>
                <TextBox Text="{Binding N, UpdateSourceTrigger=PropertyChanged}"
                         Height="30" Margin="0,5,0,10" FontSize="14"/>

                <TextBlock Text="Количество Task:"/>
                <TextBox Text="{Binding TaskCount, UpdateSourceTrigger=PropertyChanged}"
                         Height="30" Margin="0,5,0,15" FontSize="14"/>

                <Button Content="ВЫЧИСЛИТЬ"
                        Command="{Binding CalculateCommand}"
                        Height="50" Background="#4CAF50" Foreground="White"
                        FontWeight="Bold" FontSize="14"/>

                <TextBlock Text="РЕЗУЛЬТАТ:" FontWeight="Bold" Margin="0,15,0,5"/>
                <TextBlock Text="{Binding Result, StringFormat='I = {0:F10}'}"
                           FontSize="16" Foreground="#2196F3"/>

                <TextBlock Text="ВРЕМЯ (мс):" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBlock Text="{Binding ElapsedMs, StringFormat='{}{0:F2} мс'}"
                           FontSize="14" Foreground="#FF9800"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="2"
                CornerRadius="10" Margin="5" Padding="10">
            <StackPanel>
                <TextBlock Text="ИСТОРИЯ (PostgreSQL)" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="True"
                          Height="480" FontSize="11"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

                <Button Content="ОЧИСТИТЬ ИСТОРИЮ" Command="{Binding ClearCommand}"
                        Height="35" Background="#FF5722" Foreground="White"
                        FontWeight="Bold" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <StatusBar Grid.Row="2" Grid.ColumnSpan="2" Margin="5" Background="#E0E0E0" Padding="5">
            <TextBlock Text="{Binding Status}" FontSize="12" FontStyle="Italic"/>
        </StatusBar>
    </Grid>
</Window>