<Window x:Class="NewtonApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Метод Ньютона с БД" Height="650" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="РЕШЕНИЕ УРАВНЕНИЯ x² - 2 = 0 МЕТОДОМ НЬЮТОНА"
                   FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="2"
                CornerRadius="10" Margin="5" Padding="10">
            <StackPanel>
                <TextBlock Text="ВВОД ДАННЫХ" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Начальное приближение x₀ =" Width="200" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding InitialGuess, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" Height="35" FontSize="14" TextAlignment="Center"/>
                </StackPanel>

                <Button Content="РЕШИТЬ УРАВНЕНИЕ"
                        Command="{Binding SolveCommand}"
                        Height="50" Background="#4CAF50" Foreground="White"
                        FontWeight="Bold" FontSize="14" Margin="0,5,0,15"/>

                <TextBlock Text="РЕЗУЛЬТАТ" FontWeight="Bold" FontSize="16" Margin="0,10,0,10"/>
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5"
                        Background="#F8F9FA" Padding="10" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Result}" FontSize="14"
                               FontFamily="Consolas" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="ХОД ИТЕРАЦИЙ" FontWeight="Bold" FontSize="14" Margin="0,10,0,5"/>
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5"
                        Background="#F8F9FA" Padding="5" Height="200">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding Iterations}" FontSize="11"
                                   FontFamily="Consolas" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="2"
                CornerRadius="10" Margin="5" Padding="10">
            <StackPanel>
                <TextBlock Text="ИСТОРИЯ (PostgreSQL)" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                <DataGrid ItemsSource="{Binding History}"
                          AutoGenerateColumns="True" Height="450" FontSize="11"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

                <Button Content="ОЧИСТИТЬ ИСТОРИЮ"
                        Command="{Binding ClearCommand}"
                        Height="40" Background="#FF5722" Foreground="White"
                        FontWeight="Bold" Margin="0,15,0,0"/>
            </StackPanel>
        </Border>

        <StatusBar Grid.Row="2" Grid.ColumnSpan="2" Margin="5" Background="#E0E0E0" Padding="5">
            <TextBlock Text="{Binding Status}" FontSize="12" FontStyle="Italic"/>
        </StatusBar>
    </Grid>
</Window>